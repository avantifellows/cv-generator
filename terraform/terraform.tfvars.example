# Copy this file to terraform.tfvars and fill in your values

# AWS Configuration
aws_region = "ap-south-1"
project_name = "cv-generator"
instance_type = "t3.small"

# AWS Key Pair Name (existing key pair in your AWS account)
key_pair_name = "AvantiFellows"

# Git Repository URL
repo_url = "https://github.com/your-username/cv-generator.git"

# Cloudflare Configuration
cloudflare_email = "your-email@example.com"
cloudflare_api_key = "your-cloudflare-api-key"
cloudflare_zone_name = "avantifellows.org"
domain = "cv-generator" 

# S3 configuration for the app
app_s3_bucket_name = "your-cv-generator-bucket"
app_s3_prefix      = "prod/"

# Share token encryption key (use a long random secret)
share_token_key = "your-long-random-secret-key-for-share-url-encryption"